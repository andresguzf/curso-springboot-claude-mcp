# Plantilla de variables de entorno. Copia este archivo como .env y ajusta los valores:
#   cp .env.example .env
# Este archivo SÍ se sube a git; el .env no.

# --- PostgreSQL (Supabase → Connect → JDBC → Session pooler) ---
DB_URL=jdbc:postgresql://aws-0-<region>.pooler.supabase.com:5432/postgres
DB_USERNAME=postgres.<ref-del-proyecto>
DB_PASSWORD=tu-password

# --- Opcional ---
# SERVER_PORT=8090
# DB_POOL_SIZE=5
